local function fetchloadout(data)
    if type(data) ~= "table" then return end   

    for _, tower in ipairs(data) do
        if #File_Loadout >= 5 then break end
        table.insert(File_Loadout, tower)
    end
end
local function checkwave(state, num)
    local s, n = getwave()
    return s == state and (num == nil or n == num)
end

local function check2lo(a, b)
    if #a ~= #b then return false end
    local count = {}
    for _, v in ipairs(a) do count[v] = (count[v] or 0) + 1 end
    for _, v in ipairs(b) do
        if not count[v] then return false end
        count[v] = count[v] - 1
        if count[v] < 0 then return false end
    end
    return true
end

