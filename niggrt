local function UnitToIndex(cf, index) -- add unit to index table
    local added = false
    local conn

    local function check(model) -- handle check if model exit
        if added or not model:IsA("Model") then return end
        local succ, pos = pcall(model.GetPivot, model) -- get pos model
        if succ and (pos.Position - cf.Position).Magnitude < 0.05 then
            added = true
            if conn then conn:Disconnect() end
            UnitIndex[index] = model.Name
        end
    end
    local tower = workspace.Game.Towers
    conn = tower.DescendantAdded:Connect(function(v) check(v) end)
end

act.TowerAdd = function(data)
    local cf = CFrame.new(table.unpack(data.CFrame))

    local slotId = findSlotId(data.Name)
    if not slotId then
        warn("  not equipped:", data.Name)
        return
    end
    task.spawn(UnitToIndex, cf, data.Index) -- connects first
    noti("Placed", data.Name, 2)
    send(data.Remote, {
        Name = data.Name,
        UnitId = slotId,
        Pos = Vector3.new(table.unpack(data.Pos)),
        CFrame = cf
    })

    local t0 = os.clock()
    while not UnitIndex[data.Index] and os.clock() - t0 < 3 do
        task.wait(0.05)
    end

    if not UnitIndex[data.Index] then warn("no id for tower", data.Index) end
end

act.TowerUpgrade = function(data)
    local t0 = os.clock()
    while not UnitIndex[data.Index] and os.clock() - t0 < 2 do
        task.wait(0.05)
    end

    local id = UnitIndex[data.Index]
    if not id then return warn("no id for tower", data.Index) end
    noti("Upgraded", data.Name, 2)
    send(data.Remote, {Id = id})
end

