local function getwave()
    local wave = PS.LocalPlayer.PlayerGui.GameUI.Stats.Wave.Text

    local waveT = wave:match("^[Ww]ave%s*(%d+)")
    if waveT then return "wave", tonumber(waveT) end

    local voteN = wave:match("^[Vv]oting%s*%((%d+)%)")

    if voteN then return "Voting", tonumber(voteN) end
    local voteT = wave:match("^[Vv]oting")
    if voteT then return "Voting", nil end
    local InT = wave:match("^[Ii]ntermission%s*%((%d+)%)")
    if  InT then
        return "Intermission" , tonumber(InT)
    end
    return nil, nil

end

local function gettime()
    local ok, text = pcall(function()
        return PS.LocalPlayer.PlayerGui.TopbarStandard.Holders.Left.Widget
                   .IconButton.Menu.IconSpot.Contents.IconLabelContainer
                   .IconLabel.Text
    end)

    if ok and text:match("^%d%d:%d%d$") then return text end
end
---------------------------------------------------------------------
local function getRemote(name)
    local r = (NET:FindFirstChild("RemoteFunction") and
                  NET.RemoteFunction:FindFirstChild(name)) or
                  (NET:FindFirstChild("RemoteEvent") and
                      NET.RemoteEvent:FindFirstChild(name))
    return r or error("Remote not found: " .. name)
end

---------------------------------------------------------------------
local function send(name, ...)
    local r = getRemote(name)
    if r:IsA("RemoteFunction") then return r:InvokeServer(...) end
    r:FireServer(...)
end
