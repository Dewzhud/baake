local function findSlotId(name)
    local plr = PS.LocalPlayer
    local SlotFrame = game:GetService("Players").LocalPlayer.PlayerGui.GameUI
                          .Slots
    for n = 1, 5 do
        if plr:GetAttribute("Slot" .. n) == name then

            local id = plr:GetAttribute("Slot" .. n .. "Id")
            if id ~= nil then return tostring(id), n end
        end
    end
end

